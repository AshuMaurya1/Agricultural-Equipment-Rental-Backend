PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tractor_rental

# SMTP is required to send verification, reset, and security-alert emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=TractorHub <no-reply@example.com>

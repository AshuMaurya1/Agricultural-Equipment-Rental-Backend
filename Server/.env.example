PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tractor_rental

# Token Lifetimes
ACCESS_TOKEN_LIFETIME=15m
REFRESH_TOKEN_DAYS=30

# ImageKit Configuration (Required for tractor and user photo uploads)
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# SMTP is required to send verification, reset, and security-alert emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=TractorHub <no-reply@example.com>
